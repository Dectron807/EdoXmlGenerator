<UserControl x:Class="EdoXmlGenerator.Views.CatalogFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:EdoXmlGenerator.Models.Catalog"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ErrorNoteStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0392B"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA3B2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="11,0,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Шаблон строки "метка слева — поле + подсказка + пометка справа" -->
        <DataTemplate x:Key="FieldRowTemplate" DataType="models:FieldVm">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="{Binding Label}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>

                <!-- Однострочный текст -->
                <Grid Grid.Column="1" Margin="0,2" ClipToBounds="True" HorizontalAlignment="Left"
                      Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="{Binding MaxLength}" MaxWidth="500"
                             MinWidth="240" VerticalContentAlignment="Center"/>
                    <TextBlock Text="{Binding Placeholder}" Style="{StaticResource PlaceholderStyle}"
                               Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Многострочный текст -->
                <Grid Grid.Column="1" Margin="0,2" ClipToBounds="True" HorizontalAlignment="Left"
                      Visibility="{Binding IsTextArea, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxWidth="600"
                             MinWidth="400" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Placeholder}" Style="{StaticResource PlaceholderStyle}"
                               VerticalAlignment="Top" Margin="11,8,0,0"
                               Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Число / деньги -->
                <Grid Grid.Column="1" Margin="0,2" ClipToBounds="True" HorizontalAlignment="Left"
                      Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                             MaxWidth="220" MinWidth="140" VerticalContentAlignment="Center"/>
                    <TextBlock Text="{Binding Placeholder}" Style="{StaticResource PlaceholderStyle}"
                               Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <DatePicker Grid.Column="1" SelectedDate="{Binding Date}" MinWidth="180" MaxWidth="180"
                            HorizontalAlignment="Left" VerticalContentAlignment="Center"
                            Margin="0,2"
                            Visibility="{Binding IsDate, Converter={StaticResource BoolToVis}}"/>

                <CheckBox Grid.Column="1" IsChecked="{Binding Checked}" VerticalAlignment="Center"
                          Margin="4,2"
                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}"/>

                <!-- Пометка о некорректном формате - справа от поля -->
                <TextBlock Grid.Column="2" Text="{Binding ErrorText}" Style="{StaticResource ErrorNoteStyle}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,4,0,16" TextWrapping="Wrap"/>

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:SectionVm">
                        <StackPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource SectionHeader}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}"/>
                            </Border>
                            <GroupBox>
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="FieldRowTemplate"/>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Таблица позиций для документов с itemsTable -->
            <StackPanel Margin="0,8,0,0"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource SectionHeader}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Позиции (товары, работы, услуги)"/>
                </Border>
                <GroupBox>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="+ Добавить позицию" Command="{Binding AddProductCommand}"/>
                            <Button Content="− Удалить" Command="{Binding RemoveProductCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=ProductsGrid}"
                                    Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <DataGrid x:Name="ProductsGrid" ItemsSource="{Binding Products}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="320"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding LineNumber}" Width="42" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" MinWidth="180"/>
                                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="70"/>
                                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="80"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="90"/>
                                <DataGridTextColumn Header="НДС, %" Binding="{Binding VatRate}" Width="70"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat={}{0:F2}}" Width="100" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <TextBlock Text="Итого без НДС:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalWithoutVat}" FontWeight="Bold" Margin="6,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="НДС:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalVat}" FontWeight="Bold" Margin="6,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Всего:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Total}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,20">
                <Button Content="Сохранить шаблон (XML)" Command="{Binding SaveTemplateCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="20,10"/>
                <Button Content="Загрузить шаблон (XML)" Command="{Binding LoadTemplateCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="20,10" Margin="10,0,18,0"/>
                <Button Content="Сформировать XML" Command="{Binding GenerateCommand}"
                        FontSize="15" Padding="24,10"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
