<UserControl x:Class="EdoXmlGenerator.Views.DocumentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding FormTitle}" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
            </StackPanel>

            <GroupBox Header="Реквизиты документа">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}"
                               Text="Номер:" VerticalAlignment="Center" Margin="0,0,10,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                             MaxWidth="200" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}"
                               Text="Дата:" VerticalAlignment="Center" Margin="0,8,10,4"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding DocumentDate}"
                                MaxWidth="200" HorizontalAlignment="Left"/>
                </Grid>
            </GroupBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="{Binding SupplierHeader}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Наименование"/>
                        <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ИНН" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding SupplierInn, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="КПП" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding SupplierKpp, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"/>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ОКПО" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding SupplierOkpo, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Адрес" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding SupplierAddress, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="{Binding BuyerHeader}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Наименование"/>
                        <TextBox Text="{Binding BuyerName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ИНН" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding BuyerInn, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="КПП" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding BuyerKpp, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"/>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ОКПО" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding BuyerOkpo, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Адрес" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding BuyerAddress, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GroupBox Header="{Binding ProductsHeader}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{Binding AddProductButtonText}" Command="{Binding AddProductCommand}"/>
                        <Button Content="Удалить выбранную" Command="{Binding RemoveProductCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=ProductsGrid}"
                                Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0"/>
                        <Button Content="Импорт из Excel" Command="{Binding ImportExcelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                        <Button Content="Импорт из JSON" Command="{Binding ImportJsonCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="ProductsGrid" ItemsSource="{Binding Products}"
                              SelectedIndex="{Binding SelectedIndex}" Height="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="70"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                            <DataGridComboBoxColumn Header="Ед." x:Name="UnitColumn" Width="90"/>
                            <DataGridTemplateColumn Header="Ед." Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Name" DisplayMemberPath="Display"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="90"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="100"/>
                            <DataGridTemplateColumn Header="НДС" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VatRate, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.VatRates, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding VatRate, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat={}{0:F2}}" Width="110" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="Итого без НДС:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalWithoutVat}" FontWeight="Bold" Margin="6,0,20,0" VerticalAlignment="Center"/>
                        <TextBlock Text="НДС:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalVat}" FontWeight="Bold" Margin="6,0,20,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Всего:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Total}" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <Button Content="Сформировать XML" Command="{Binding GenerateXmlCommand}"
                    FontSize="15" Padding="24,10" HorizontalAlignment="Right"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
